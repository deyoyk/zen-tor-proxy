# zen-tor-proxy configuration
# Copy this file to `.env` next to the binary and edit values, then restart the app.

# API key sent upstream (any value works; the upstream accepts a public key).
ZEN_API_KEY=public

# Local listen address/port for the OpenAI-compatible endpoint.
HOST=127.0.0.1
PORT=5678

# OpenAI-compatible chat completions endpoint to proxy through Tor.
UPSTREAM_URL=https://opencode.ai/zen/v1/chat/completions

# Optional bearer token required from local clients (empty = no auth).
# Strongly recommended if you bind HOST to anything other than 127.0.0.1.
LOCAL_AUTH_TOKEN=

# Timeout for upstream requests, in milliseconds.
UPSTREAM_TIMEOUT_MS=300000

# ---------------- Exit-IP rotation ----------------
# Scheduled rotation interval in milliseconds. 0 disables the timer; the proxy
# then rotates on demand whenever the upstream model returns an error.
# Set to 600000 for rotation every 10 minutes.
IP_ROTATE_INTERVAL_MS=0

# Rotate the Tor exit IP when the upstream model returns an error.
ROTATE_ON_UPSTREAM_ERROR=true

# Rotate on ANY 4xx/5xx response. Set to false to rotate only on quota-style
# errors (402/429 or messages mentioning usage limits / free usage exceeded).
ROTATE_ON_ANY_UPSTREAM_ERROR=true

# Automatically re-send the failed request once over the new exit IP.
ROTATE_RETRY_REQUESTS=true

# Maximum automatic retries after rotating the exit IP (raise for effectively
# infinite retries; 0 disables retrying).
ROTATE_MAX_RETRIES=100

# Total wall-clock budget for all retries of one request, in milliseconds.
# 0 = no time cap (only ROTATE_MAX_RETRIES bounds the retry loop).
ROTATE_RETRY_WINDOW_MS=300000

# Minimum gap between on-demand rotations, in milliseconds.
ROTATE_ON_ERROR_COOLDOWN_MS=20000

# ---------------- Tor ----------------
# Automatically install Tor if no binary is found.
AUTO_INSTALL_TOR=true

# Optional explicit path to a Tor binary.
#TOR_BINARY_PATH=

# SOCKS / control ports (0 = pick a free port automatically).
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051

# Directory where Tor keeps its data and keys.
#TOR_DATA_DIR=./data/tor

# Comma-separated Tor bridges (optional).
#TOR_BRIDGES=

# How long to wait for Tor to finish bootstrapping, in milliseconds.
TOR_BOOTSTRAP_TIMEOUT_MS=180000

# Comma-separated public-IP check endpoints, tried in order.
IP_CHECK_PROVIDERS=https://check.torproject.org/api/ip,https://api.ipify.org?format=json,https://ipinfo.io/ip

# ---------------- Misc ----------------
# Log level: debug | info | warn | error
LOG_LEVEL=info

# Optional log file path (default: zen-tor-proxy.log next to the binary).
#LOG_FILE=
