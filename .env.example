# All settings are optional. The proxy works out of the box:
#   - upstream key defaults to "public" (OpenCode Zen free tier)
#   - a client's own Authorization header always takes precedence
#   - Tor is auto-installed, auto-started, exit IP rotates every 10 min

# Upstream OpenCode Zen API key (default: public)
ZEN_API_KEY=

# Local listener
PORT=5678
HOST=127.0.0.1

# Upstream OpenAI-compatible endpoint
UPSTREAM_URL=https://opencode.ai/zen/v1/chat/completions

# Optional bearer token required from local clients (empty = no auth).
# Strongly recommended if you bind HOST to anything other than 127.0.0.1.
LOCAL_AUTH_TOKEN=

# Tor acquisition
#   true  -> auto-download the Tor expert bundle when no Tor binary is found
#   false -> fail with a clear error instead
AUTO_INSTALL_TOR=true

# Optional: explicit path to a Tor binary (tor / tor.exe). If empty, the
# proxy searches PATH and common install locations before auto-installing.
TOR_BINARY_PATH=

# Tor listener ports. 0 = pick a free port automatically.
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051

# Directory for Tor data, config and downloaded bundles
TOR_DATA_DIR=./data/tor

# How long to wait for Tor to reach 100% bootstrap before failing
TOR_BOOTSTRAP_TIMEOUT_MS=120000

# Exit-IP rotation interval (default 600000 ms = 10 minutes)
IP_ROTATE_INTERVAL_MS=600000

# Comma-separated public-IP check endpoints, tried in order
IP_CHECK_PROVIDERS=https://check.torproject.org/api/ip,https://api.ipify.org?format=json,https://ipinfo.io/ip

# Upstream request idle timeout (streaming resets the timer on activity)
UPSTREAM_TIMEOUT_MS=300000

# debug | info | warn | error
LOG_LEVEL=info
